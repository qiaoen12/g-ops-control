{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/export-manifest.v1.json",
  "title": "Non-sensitive export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "owner_id", "created_at", "bundle_id", "files", "excluded_categories", "observation_times", "required_identity_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "export_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "owner_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "created_at": {"$ref": "common.v1.json#/$defs/utc"},
    "bundle_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "files": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"$ref": "common.v1.json#/$defs/evidence_ref"},
          "size": {"type": "integer", "minimum": 0, "maximum": 104857600},
          "sha256": {"$ref": "common.v1.json#/$defs/digest"}
        }
      }
    },
    "excluded_categories": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/non_empty_text"}, "uniqueItems": true, "maxItems": 256},
    "observation_times": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "observed_at"],
        "properties": {"kind": {"$ref": "common.v1.json#/$defs/safe_id"}, "observed_at": {"$ref": "common.v1.json#/$defs/utc"}}
      }
    },
    "required_identity_refs": {"$ref": "common.v1.json#/$defs/id_array"}
  }
}
