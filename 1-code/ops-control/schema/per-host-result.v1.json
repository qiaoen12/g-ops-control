{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/per-host-result.v1.json",
  "title": "Per-host run result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_id", "run_id", "host_id", "action_id", "phase", "status", "changed", "exit_code", "error_code", "started_at", "finished_at", "verification", "evidence_refs", "log_ref"],
  "properties": {
    "schema_version": {"const": 1},
    "owner_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "run_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "host_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "action_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "phase": {"type": "string", "enum": ["precheck", "execute", "verify", "complete"]},
    "status": {"type": "string", "enum": ["pending", "running", "succeeded", "failed", "unreachable", "not_run", "unknown"]},
    "changed": {"type": ["boolean", "null"]},
    "exit_code": {"type": ["integer", "null"], "minimum": -255, "maximum": 255},
    "error_code": {"anyOf": [{"$ref": "common.v1.json#/$defs/safe_id"}, {"type": "null"}]},
    "started_at": {"anyOf": [{"$ref": "common.v1.json#/$defs/utc"}, {"type": "null"}]},
    "finished_at": {"anyOf": [{"$ref": "common.v1.json#/$defs/utc"}, {"type": "null"}]},
    "verification": {"type": "string", "enum": ["passed", "failed", "not_run", "unknown"]},
    "evidence_refs": {"$ref": "common.v1.json#/$defs/evidence_ref_array"},
    "log_ref": {"anyOf": [{"$ref": "common.v1.json#/$defs/evidence_ref"}, {"type": "null"}]}
  }
}
