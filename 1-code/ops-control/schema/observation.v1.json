{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/observation.v1.json",
  "title": "Observed fact envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_id", "kind", "observed_at", "last_success_at", "source", "quality", "data", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "host_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "kind": {"type": "string", "enum": ["host", "software", "backup", "service"]},
    "observed_at": {"$ref": "common.v1.json#/$defs/utc"},
    "last_success_at": {"anyOf": [{"$ref": "common.v1.json#/$defs/utc"}, {"type": "null"}]},
    "source": {"$ref": "common.v1.json#/$defs/source"},
    "quality": {"type": "string", "enum": ["fresh", "stale", "unknown", "error"]},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {"$ref": "common.v1.json#/$defs/platform"},
        "installed_version": {"$ref": "common.v1.json#/$defs/version"},
        "candidate_version": {"$ref": "common.v1.json#/$defs/version"},
        "service_state": {"type": "string", "enum": ["active", "paused", "running", "stopped", "loopback-only", "user-space", "unresolved-conflict", "unknown"]},
        "backup_last_success_at": {"anyOf": [{"$ref": "common.v1.json#/$defs/utc"}, {"type": "null"}]},
        "evidence_ref": {"$ref": "common.v1.json#/$defs/evidence_ref"},
        "summary": {"$ref": "common.v1.json#/$defs/text"}
      }
    },
    "error": {"anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/error"}]}
  }
}
