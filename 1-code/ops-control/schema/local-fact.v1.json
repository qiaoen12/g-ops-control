{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/local-fact.v1.json",
  "title": "Client-reported local software fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_id", "software_id", "platform", "install_kind", "installed_version", "source", "observed_at", "evidence_summary"],
  "properties": {
    "schema_version": {"const": 1},
    "host_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "software_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "platform": {"$ref": "common.v1.json#/$defs/platform"},
    "install_kind": {"type": "string", "enum": ["package", "binary", "container", "source", "unknown"]},
    "installed_version": {"$ref": "common.v1.json#/$defs/version"},
    "source": {"$ref": "common.v1.json#/$defs/source"},
    "observed_at": {"$ref": "common.v1.json#/$defs/utc"},
    "evidence_summary": {"$ref": "common.v1.json#/$defs/non_empty_text"}
  }
}
