{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/knowledge-note.v1.json",
  "title": "Knowledge note",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "note_id", "owner_id", "run_id", "host_id", "software_id", "environment", "from_version", "to_version", "source", "problem", "resolution", "evidence_refs", "confidence", "created_at", "author_provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "note_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "owner_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "run_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "host_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "software_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "environment": {"$ref": "common.v1.json#/$defs/non_empty_text"},
    "from_version": {"$ref": "common.v1.json#/$defs/version"},
    "to_version": {"$ref": "common.v1.json#/$defs/version"},
    "source": {"$ref": "common.v1.json#/$defs/source"},
    "problem": {"$ref": "common.v1.json#/$defs/non_empty_text"},
    "resolution": {"$ref": "common.v1.json#/$defs/non_empty_text"},
    "evidence_refs": {"$ref": "common.v1.json#/$defs/evidence_ref_array"},
    "confidence": {"type": "string", "enum": ["verified", "hypothesis", "unresolved"]},
    "created_at": {"$ref": "common.v1.json#/$defs/utc"},
    "author_provenance": {"$ref": "common.v1.json#/$defs/non_empty_text"}
  }
}
