{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/operation-package.v1.json",
  "title": "Bound high-privilege operation package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "owner_id", "content_digest", "script_files", "parameter_schema", "typed_params", "target_ids", "reason", "expected_effects", "prohibited_effects", "prechecks", "postchecks", "recovery_evidence", "max_runtime_seconds", "reentrancy"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "owner_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "content_digest": {"$ref": "common.v1.json#/$defs/digest"},
    "script_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "common.v1.json#/$defs/evidence_ref"},
          "sha256": {"$ref": "common.v1.json#/$defs/digest"}
        }
      }
    },
    "parameter_schema": {"$ref": "common.v1.json#/$defs/schema_fragment"},
    "typed_params": {"$ref": "common.v1.json#/$defs/json_object"},
    "target_ids": {"allOf": [{"$ref": "common.v1.json#/$defs/id_array"}, {"minItems": 1}]},
    "reason": {"$ref": "common.v1.json#/$defs/non_empty_text"},
    "expected_effects": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/non_empty_text"}, "maxItems": 256},
    "prohibited_effects": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/non_empty_text"}, "maxItems": 256},
    "prechecks": {"$ref": "common.v1.json#/$defs/id_array"},
    "postchecks": {"$ref": "common.v1.json#/$defs/id_array"},
    "recovery_evidence": {"$ref": "common.v1.json#/$defs/evidence_ref_array"},
    "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "reentrancy": {"type": "string", "enum": ["converge", "read_only", "manual_review"]}
  }
}
