{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/service-fact.v1.json",
  "title": "Service fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service_id", "host_id", "expected_state", "actual_state", "observed_at", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "service_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "host_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "expected_state": {"type": "string", "enum": ["active", "paused", "running", "stopped", "loopback-only", "user-space", "unresolved-conflict", "unknown"]},
    "actual_state": {"type": "string", "enum": ["active", "paused", "running", "stopped", "loopback-only", "user-space", "unresolved-conflict", "unknown"]},
    "observed_at": {"$ref": "common.v1.json#/$defs/utc"},
    "error": {"anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/error"}]}
  }
}
