{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/run-summary.v1.json",
  "title": "Run summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_id", "run_id", "plan_id", "created_at", "finished_at", "status", "target_count", "counts", "hosts", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "owner_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "run_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "plan_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "created_at": {"$ref": "common.v1.json#/$defs/utc"},
    "finished_at": {"anyOf": [{"$ref": "common.v1.json#/$defs/utc"}, {"type": "null"}]},
    "status": {"type": "string", "enum": ["running", "succeeded", "partial", "failed", "unknown"]},
    "target_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "running", "succeeded", "failed", "unreachable", "not_run", "unknown"],
      "properties": {
        "pending": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "unreachable": {"type": "integer", "minimum": 0},
        "not_run": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "hosts": {"$ref": "common.v1.json#/$defs/id_array"},
    "warnings": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/text"}, "maxItems": 10000}
  }
}
