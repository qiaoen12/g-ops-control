{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/response.v1.json",
  "title": "OPS v1 response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "ok", "data", "error", "generated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "ok": {"type": "boolean"},
    "data": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "common.v1.json#/$defs/doctor_data"},
        {"type": "object", "additionalProperties": false}
      ]
    },
    "error": {"anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/error"}]},
    "generated_at": {"$ref": "common.v1.json#/$defs/utc"}
  }
}
