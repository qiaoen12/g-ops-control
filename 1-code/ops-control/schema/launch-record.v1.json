{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/launch-record.v1.json",
  "title": "Immutable launch attempt record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_id", "run_id", "bundle_id", "attempted_at"],
  "properties": {
    "schema_version": {"const": 1},
    "owner_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "run_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "bundle_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "attempted_at": {"$ref": "common.v1.json#/$defs/utc"}
  }
}
