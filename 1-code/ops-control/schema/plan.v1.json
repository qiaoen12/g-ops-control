{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/plan.v1.json",
  "title": "Bound immutable execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "owner_id", "created_at", "expires_at", "recovery_generation", "action_id", "action_version", "bundle_id", "policy_digest", "resolved_targets", "excluded", "target_bindings", "resolved_params", "package_digest", "impact", "recovery_evidence_refs", "verification", "elevated", "max_runtime_seconds", "plan_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "owner_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "created_at": {"$ref": "common.v1.json#/$defs/utc"},
    "expires_at": {"$ref": "common.v1.json#/$defs/utc"},
    "recovery_generation": {"$ref": "common.v1.json#/$defs/uuid"},
    "action_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "action_version": {"$ref": "common.v1.json#/$defs/non_empty_text"},
    "bundle_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "policy_digest": {"$ref": "common.v1.json#/$defs/digest"},
    "resolved_targets": {"$ref": "common.v1.json#/$defs/id_array"},
    "excluded": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host_id", "reason"],
        "properties": {"host_id": {"$ref": "common.v1.json#/$defs/safe_id"}, "reason": {"$ref": "common.v1.json#/$defs/non_empty_text"}}
      }
    },
    "target_bindings": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10000,
      "propertyNames": {"$ref": "common.v1.json#/$defs/safe_id"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connection_digest", "platform", "policy_digest"],
        "properties": {
          "connection_digest": {"$ref": "common.v1.json#/$defs/digest"},
          "platform": {"$ref": "common.v1.json#/$defs/platform"},
          "policy_digest": {"$ref": "common.v1.json#/$defs/digest"}
        }
      }
    },
    "resolved_params": {"$ref": "common.v1.json#/$defs/json_object"},
    "package_digest": {"anyOf": [{"$ref": "common.v1.json#/$defs/digest"}, {"type": "null"}]},
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "service_interruption", "data_risk", "restart_required"],
      "properties": {
        "summary": {"$ref": "common.v1.json#/$defs/non_empty_text"},
        "service_interruption": {"type": "boolean"},
        "data_risk": {"type": "boolean"},
        "restart_required": {"type": "boolean"}
      }
    },
    "recovery_evidence_refs": {"$ref": "common.v1.json#/$defs/evidence_ref_array"},
    "verification": {"$ref": "common.v1.json#/$defs/id_array"},
    "elevated": {"type": "boolean"},
    "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "plan_digest": {"$ref": "common.v1.json#/$defs/digest"}
  }
}
