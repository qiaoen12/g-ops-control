{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/software-fact.v1.json",
  "title": "Software fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "software_id", "host_id", "platform", "install_kind", "installed_version", "source", "observed_at", "evidence_ref", "candidate_version", "candidate_checked_at"],
  "properties": {
    "schema_version": {"const": 1},
    "software_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "host_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "platform": {"$ref": "common.v1.json#/$defs/platform"},
    "install_kind": {"type": "string", "enum": ["package", "binary", "container", "source", "unknown"]},
    "installed_version": {"$ref": "common.v1.json#/$defs/version"},
    "source": {"$ref": "common.v1.json#/$defs/source"},
    "observed_at": {"$ref": "common.v1.json#/$defs/utc"},
    "evidence_ref": {"$ref": "common.v1.json#/$defs/evidence_ref"},
    "candidate_version": {"$ref": "common.v1.json#/$defs/version"},
    "candidate_checked_at": {"anyOf": [{"$ref": "common.v1.json#/$defs/utc"}, {"type": "null"}]}
  }
}
