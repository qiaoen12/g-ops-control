{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/action-descriptor.v1.json",
  "title": "Registered action descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action_id", "action_version", "mode", "enabled", "parameter_schema", "target_kinds", "platform_constraints", "policy_refs", "adapter_ref", "prechecks", "postchecks", "recovery_requirement", "reentrancy", "timeout_seconds", "sensitive_output", "credential_requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "action_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "action_version": {"$ref": "common.v1.json#/$defs/non_empty_text"},
    "mode": {"type": "string", "enum": ["read", "write", "elevated"]},
    "enabled": {"type": "boolean"},
    "parameter_schema": {"$ref": "common.v1.json#/$defs/schema_fragment"},
    "target_kinds": {"type": "array", "items": {"type": "string", "enum": ["server", "local_client"]}, "uniqueItems": true, "minItems": 1},
    "platform_constraints": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/non_empty_text"}, "uniqueItems": true, "maxItems": 64},
    "policy_refs": {"$ref": "common.v1.json#/$defs/id_array"},
    "adapter_ref": {"$ref": "common.v1.json#/$defs/evidence_ref"},
    "prechecks": {"$ref": "common.v1.json#/$defs/id_array"},
    "postchecks": {"$ref": "common.v1.json#/$defs/id_array"},
    "recovery_requirement": {"type": "string", "enum": ["none", "required", "manual_review"]},
    "reentrancy": {"type": "string", "enum": ["converge", "read_only", "manual_review"]},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "sensitive_output": {"type": "boolean"},
    "credential_requirements": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/credential_requirement"}, "uniqueItems": true, "maxItems": 256}
  }
}
