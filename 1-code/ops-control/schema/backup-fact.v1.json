{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/backup-fact.v1.json",
  "title": "Backup fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_id", "backup_kind", "expected", "last_success_at", "snapshot_ref", "coverage_ref", "last_check_at", "last_restore_test_at", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "host_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "backup_kind": {"type": "string", "enum": ["file", "snapshot", "database", "unknown"]},
    "expected": {"type": "boolean"},
    "last_success_at": {"anyOf": [{"$ref": "common.v1.json#/$defs/utc"}, {"type": "null"}]},
    "snapshot_ref": {"anyOf": [{"$ref": "common.v1.json#/$defs/evidence_ref"}, {"type": "null"}]},
    "coverage_ref": {"anyOf": [{"$ref": "common.v1.json#/$defs/evidence_ref"}, {"type": "null"}]},
    "last_check_at": {"anyOf": [{"$ref": "common.v1.json#/$defs/utc"}, {"type": "null"}]},
    "last_restore_test_at": {"anyOf": [{"$ref": "common.v1.json#/$defs/utc"}, {"type": "null"}]},
    "error": {"anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/error"}]}
  }
}
