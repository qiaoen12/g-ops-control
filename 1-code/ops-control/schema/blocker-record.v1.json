{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/blocker-record.v1.json",
  "title": "Immutable host blocker record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_id", "host_id", "run_id", "lock_groups", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "owner_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "host_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "run_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "lock_groups": {"$ref": "common.v1.json#/$defs/id_array"},
    "created_at": {"$ref": "common.v1.json#/$defs/utc"}
  }
}
