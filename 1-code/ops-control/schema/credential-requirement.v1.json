{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-control.invalid/schema/credential-requirement.v1.json",
  "title": "Non-secret credential requirement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "credential_id", "scope", "required"],
  "properties": {
    "schema_version": {"const": 1},
    "credential_id": {"$ref": "common.v1.json#/$defs/safe_id"},
    "scope": {"type": "string", "enum": ["shared", "per-host"]},
    "required": {"type": "boolean"},
    "host_id": {"anyOf": [{"$ref": "common.v1.json#/$defs/safe_id"}, {"type": "null"}]},
    "reason": {"$ref": "common.v1.json#/$defs/text"}
  },
  "allOf": [
    {"if": {"properties": {"scope": {"const": "per-host"}}}, "then": {"required": ["host_id"], "properties": {"host_id": {"$ref": "common.v1.json#/$defs/safe_id"}}}},
    {"if": {"properties": {"scope": {"const": "shared"}}}, "then": {"properties": {"host_id": {"type": "null"}}}}
  ]
}
